# Shared ignore rules for Unity projects stored below this directory.
# Patterns without a leading slash apply to matching directories in every project.

# Unity-generated directories and caches
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
[Tt]extMesh Pro/
ExportedObj/
ServerData/
_Recovery/
_Recovery.meta

# Editor and tooling caches/settings
.idea/
.vscode/
.vs/
.gradle/
.consulo/
*.DotSettings.user

# Generated logs, crash reports, and temporary files
*.log
sysinfo.txt
mono_crash.*
*.tmp

# Generated solution/project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity-generated companion files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Blender and Unity build artifacts
*.blend1
*.blend1.meta
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Unity and package generated files
crashlytics-build.properties
InitTestScene*.unity*

# Generated files under each project's Assets directory
**/[Aa]ssets/Plugins/Editor/JetBrains*
**/[Aa]ssets/TextMesh Pro.meta
**/[Aa]ssets/StreamingAssets/aa*
**/[Aa]ssets/AddressableAssetsData/link.xml*
**/[Aa]ssets/Addressables_Temp*
**/[Aa]ssets/AddressableAssetsData/*/*.bin*
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
**/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
**/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
**/[Aa]ssets/[Ss]ceneDependencyCache*

# OS-generated files
*.DS_Store
