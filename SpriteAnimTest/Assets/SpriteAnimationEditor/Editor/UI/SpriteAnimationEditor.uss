.sprite-animation-window {
    flex-grow: 1;
    min-width: 340px;
}

.sprite-animation-toolbar {
    flex-direction: row;
    padding: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.35);
}

.sprite-animation-toolbar > Button {
    margin-right: 3px;
}

.sprite-animation-toolbar-spacer {
    flex-grow: 1;
}

.sprite-animation-primary-button {
    -unity-font-style: bold;
}

.sprite-animation-tree {
    flex-grow: 1;
    min-height: 180px;
}

.sprite-animation-tree-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.sprite-animation-tree-toggle {
    width: 18px;
    margin-left: 1px;
    margin-right: 3px;
}

.sprite-animation-tree-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.sprite-animation-tree-label {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.sprite-animation-status {
    margin: 4px;
}

.sprite-animation-inspector {
    flex-grow: 0;
    flex-shrink: 0;
    min-height: 0;
    padding-left: 4px;
    padding-right: 4px;
    padding-bottom: 6px;
}

.sprite-animation-duration-override-field__input {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.sprite-animation-duration-override-field__toggle {
    flex-grow: 0;
    flex-shrink: 0;
    width: 18px;
    min-width: 18px;
    margin-top: 0;
    margin-right: 3px;
    margin-bottom: 0;
    margin-left: 0;
}

.sprite-animation-duration-override-field__integer {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 50px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
}

.sprite-animation-frame-list-container {
    margin-top: 6px;
}

.sprite-animation-frame-list {
    max-height: none;
}

.sprite-animation-frame-list-header__menu {
    flex-grow: 0;
    flex-shrink: 0;
    width: 18px;
    min-width: 18px;
    height: 18px;
    margin-top: 0;
    margin-right: 54px;
    margin-bottom: 0;
    margin-left: 0;
    padding: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sprite-animation-frame-list-header__menu > .unity-toolbar-menu__arrow {
    display: none;
}

.sprite-animation-frame-list .unity-list-view__reorderable-handle-bar {
    translate: 0 15px;
}

.sprite-animation-frame-row-host {
    flex-grow: 1;
}

.sprite-animation-frame-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    height: 48px;
    padding-left: 3px;
    padding-right: 3px;
}

.sprite-animation-frame-thumbnail {
    width: 40px;
    height: 40px;
    margin-right: 6px;
}

.sprite-animation-frame-fields {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.sprite-animation-frame-sprite-field {
    flex-grow: 0;
    flex-shrink: 0;
}

.sprite-animation-standard-preview {
    flex-grow: 1;
    min-height: 0;
}

.sprite-animation-preview-image {
    flex-grow: 1;
    min-height: 0;
    margin: 6px;
    background-color: rgba(0, 0, 0, 0.16);
}

.sprite-animation-preview-footer {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 22px;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 4px;
}

.sprite-animation-preview-slider {
    flex-grow: 1;
    min-width: 80px;
}

.sprite-animation-preview-status {
    min-width: 150px;
    margin-left: 8px;
    -unity-text-align: middle-right;
    color: rgba(210, 210, 210, 0.85);
}

.sprite-animation-generate-group-button {
    height: 26px;
    margin-top: 8px;
    margin-bottom: 4px;
}
