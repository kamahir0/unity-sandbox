<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="main-container" style="flex-direction: column; flex-grow: 1;">
        
        <ui:VisualElement name="header-panel" style="flex-direction: row; height: 60px; background-color: rgb(34, 34, 34); align-items: center; padding-left: 20px; padding-right: 20px;">
            <ui:Image name="game-logo" style="width: 40px; height: 40px;" />
            <ui:Label name="header-title" text="スジモンバトル" style="font-size: 24px; color: rgb(255, 255, 255); margin-left: 10px; font-weight: bold;" />
        </ui:VisualElement>

        <ui:VisualElement name="content-area" style="flex-direction: row; flex-grow: 1; padding: 10px;">
            
            <ui:VisualElement name="team-panel" style="flex-direction: column; flex-grow: 1; margin: 10px; width: 33%;">
                <ui:Label name="team-panel-title" text="編成メンバー" style="color: rgb(255, 204, 0); font-size: 18px; font-weight: bold; margin-bottom: 10px;" />
                
                <ui:Label name="front-member-header" text="フロントメンバー" style="color: rgb(255, 255, 255); font-size: 14px; margin-bottom: 5px;" />
                <ui:VisualElement name="front-members-container" style="flex-direction: row; margin-bottom: 20px;">
                    <ui:VisualElement name="front-member-1" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(255, 204, 0); border-width: 3px; padding: 5px; align-items: center;">
                        <ui:Image name="fm1-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="fm1-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="fm1-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="fm1-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="fm1-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="front-member-2" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(120, 120, 120); border-width: 1px; padding: 5px; align-items: center;">
                        <ui:Image name="fm2-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="fm2-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="fm2-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="fm2-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="fm2-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="front-member-3" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(120, 120, 120); border-width: 1px; padding: 5px; align-items: center;">
                        <ui:Image name="fm3-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="fm3-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="fm3-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="fm3-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="fm3-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:Label name="back-member-header" text="バックメンバー" style="color: rgb(255, 255, 255); font-size: 14px; margin-bottom: 5px;" />
                <ui:VisualElement name="back-members-container" style="flex-direction: row;">
                    <ui:VisualElement name="back-member-1" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(120, 120, 120); border-width: 1px; padding: 5px; align-items: center;">
                        <ui:Image name="bm1-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="bm1-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="bm1-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="bm1-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="bm1-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="back-member-2" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(120, 120, 120); border-width: 1px; padding: 5px; align-items: center;">
                        <ui:Image name="bm2-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="bm2-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="bm2-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="bm2-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="bm2-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                    <ui:VisualElement name="back-member-3" style="flex-direction: column; width: 31%; margin: 1%; background-color: rgb(20, 20, 20); border-color: rgb(120, 120, 120); border-width: 1px; padding: 5px; align-items: center;">
                        <ui:Image name="bm3-portrait" style="width: 100%; height: 100px;" />
                        <ui:Image name="bm3-rarity" style="width: 24px; height: 24px; position: absolute; top: 5px; left: 5px;" />
                        <ui:Label name="bm3-level" text="レベル 50" style="color: rgb(255, 255, 255); font-size: 12px; margin-top: 5px;" />
                        <ui:Image name="bm3-attribute" style="width: 20px; height: 20px; margin-top: 5px;" />
                        <ui:Image name="bm3-trust" style="width: 16px; height: 16px; margin-top: 5px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement name="list-panel" style="flex-direction: column; flex-grow: 1; margin: 10px; width: 33%;">
                <ui:Label name="list-panel-title" text="ソート（編成順）" style="color: rgb(255, 255, 255); font-size: 16px; margin-bottom: 10px;" />
                <ui:VisualElement name="character-grid-view" style="flex-direction: row; flex-wrap: wrap; justify-content: flex-start;">
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.8); margin: 1%; border-width: 1px; border-color: rgb(60, 60, 60);" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.4); margin: 1%; border-width: 1px; border-color: rgb(40, 40, 40); opacity: 0.5;" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.4); margin: 1%; border-width: 1px; border-color: rgb(40, 40, 40); opacity: 0.5;" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.4); margin: 1%; border-width: 1px; border-color: rgb(40, 40, 40); opacity: 0.5;" />
                    <ui:VisualElement style="width: 23%; height: 80px; background-color: rgba(20, 20, 20, 0.4); margin: 1%; border-width: 1px; border-color: rgb(40, 40, 40); opacity: 0.5;" />
                </ui:VisualElement>
            </ui:VisualElement>
            
            <ui:VisualElement name="details-panel" style="flex-direction: column; flex-grow: 1; margin: 10px; width: 33%; background-color: rgba(10, 10, 10, 0.5); padding: 10px;">
                
                <ui:VisualElement name="character-header-block" style="flex-direction: row; border-width: 1px; border-color: rgb(150, 120, 0); background-color: rgb(20, 20, 20); margin-bottom: 10px;">
                    
                    <ui:VisualElement style="width: 120px; height: 120px; position: relative; background-color: rgb(180, 0, 100);">
                        <ui:Image style="position: absolute; top: 2px; left: 2px; width: 30px; height: 30px; background-color: rgb(0, 200, 200);" />
                    </ui:VisualElement>
                    
                    <ui:VisualElement style="flex-grow: 1; flex-direction: column; padding: 5px 10px 5px 10px; justify-content: space-between;">
                        
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:VisualElement style="width: 20px; height: 20px; background-color: rgb(120, 60, 180); rotate: 45deg; margin-right: 15px; margin-left: 5px;" />
                            <ui:VisualElement style="flex-direction: column;">
                                <ui:Label text="ネクロマンサー" style="color: rgb(180, 180, 180); font-size: 11px; padding: 0; margin: 0;" />
                                <ui:Label text="岩崎" style="color: rgb(255, 255, 255); font-size: 18px; font-weight: bold; padding: 0; margin: 0;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <ui:VisualElement style="height: 1px; background-color: rgb(120, 90, 0); margin-top: 6px; margin-bottom: 6px;" />
                        
                        <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                            
                            <ui:VisualElement style="flex-direction: column; width: 40%; justify-content: flex-start;">
                                <ui:VisualElement style="flex-direction: row; align-items: flex-end;">
                                    <ui:Label text="Lv." style="color: rgb(255, 255, 255); font-size: 14px; padding: 0; margin: 0; margin-right: 4px; padding-bottom: 2px;" />
                                    <ui:Label text="50" style="color: rgb(255, 255, 255); font-size: 22px; padding: 0; margin: 0;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="height: 2px; background-color: rgb(0, 0, 0); margin-top: 2px; margin-bottom: 4px;" />
                                <ui:VisualElement style="flex-direction: row; justify-content: space-between; padding-right: 5px;">
                                    <ui:Label text="あと" style="color: rgb(200, 200, 200); font-size: 11px; padding: 0; margin: 0;" />
                                    <ui:Label text="0" style="color: rgb(255, 255, 255); font-size: 14px; padding: 0; margin: 0;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            
                            <ui:VisualElement style="width: 1px; background-color: rgb(100, 80, 0); margin-left: 5px; margin-right: 5px;" />

                            <ui:VisualElement style="flex-direction: column; justify-content: space-around; width: 30%; padding-left: 5px;">
                                <ui:VisualElement style="flex-direction: row; align-items: center;">
                                    <ui:Image style="width: 14px; height: 14px; background-color: rgb(255, 255, 255); margin-right: 6px;" /> <ui:Label text="663" style="color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; padding: 0; margin: 0;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; align-items: center;">
                                    <ui:Image style="width: 14px; height: 14px; background-color: rgb(255, 255, 255); margin-right: 6px;" /> <ui:Label text="241" style="color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; padding: 0; margin: 0;" />
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-direction: row; align-items: center;">
                                    <ui:Image style="width: 14px; height: 14px; background-color: rgb(255, 255, 255); margin-right: 6px;" /> <ui:Label text="180" style="color: rgb(255, 255, 255); font-size: 16px; font-weight: bold; padding: 0; margin: 0;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            
                            <ui:VisualElement style="width: 1px; background-color: rgb(100, 80, 0); margin-left: 5px; margin-right: 5px;" />

                            <ui:VisualElement style="flex-direction: column; align-items: center; justify-content: center; width: 30%;">
                                <ui:Image style="width: 32px; height: 32px; background-color: rgb(0, 220, 180); margin-bottom: 4px;" /> <ui:Label text="100/100" style="color: rgb(255, 255, 255); font-size: 12px; padding: 0; margin: 0;" />
                            </ui:VisualElement>
                            
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement name="skill1-block" style="flex-direction: column; background-color: rgb(230, 180, 34); padding: 5px; margin-bottom: 10px; border-radius: 3px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label name="skill1-name" text="殴打" style="color: rgb(0, 0, 0); font-size: 14px; font-weight: bold;" />
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="SP" style="color: rgb(0, 0, 0); font-size: 10px; margin-right: 3px;" />
                            <ui:Label name="skill1-sp-value" text="7" style="color: rgb(0, 0, 0); font-size: 16px; font-weight: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="skill1-description" text="金槌で殴りつける凶悪な一打だ" style="color: rgb(30, 30, 30); font-size: 11px; margin-top: 3px;" />
                </ui:VisualElement>
                
                <ui:VisualElement name="skill2-block" style="flex-direction: column; background-color: rgb(220, 80, 130); padding: 5px; border-radius: 3px;">
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label name="skill2-name" text="丑の刻" style="color: rgb(255, 255, 255); font-size: 14px; font-weight: bold;" />
                        <ui:VisualElement style="flex-direction: row; align-items: center;">
                            <ui:Label text="MP" style="color: rgb(255, 255, 255); font-size: 10px; margin-right: 3px;" />
                            <ui:Label name="skill2-sp-value" text="2" style="color: rgb(255, 255, 255); font-size: 16px; font-weight: bold;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="skill2-description" text="日頃の恨みを相手に叩きつけるとても迷惑な一撃" style="color: rgb(240, 240, 240); font-size: 11px; margin-top: 3px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="footer-panel" style="flex-direction: row; height: 40px; background-color: rgb(20, 20, 20); align-items: center; justify-content: flex-end; padding-left: 20px; padding-right: 20px;">
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-left: 15px;">
                <ui:Image style="width: 16px; height: 16px; background-color: rgb(100, 100, 255);" />
                <ui:Label text="愛称変更" style="color: rgb(255, 255, 255); font-size: 12px; margin-left: 4px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-left: 15px;">
                <ui:Image style="width: 16px; height: 16px; background-color: rgb(255, 200, 0);" />
                <ui:Label text="位置の入れ替え" style="color: rgb(255, 255, 255); font-size: 12px; margin-left: 4px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-left: 15px;">
                <ui:Image style="width: 16px; height: 16px; background-color: rgb(0, 200, 0);" />
                <ui:Label text="選択" style="color: rgb(255, 255, 255); font-size: 12px; margin-left: 4px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; margin-left: 15px;">
                <ui:Image style="width: 16px; height: 16px; background-color: rgb(200, 0, 0);" />
                <ui:Label text="戻る" style="color: rgb(255, 255, 255); font-size: 12px; margin-left: 4px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        
    </ui:VisualElement>
</ui:UXML>